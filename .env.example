# Copiar a Files/.env (no commitear). Mismo JWT/SQL que Auth y Backend.
AppSettings__Secret=
ConnectionStrings__DefaultConnection=
AppSettings__ConnectionStringsRedis=
Storage__R2__Enabled=false
Storage__R2__ServiceUrl=
Storage__R2__BucketName=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
# Error por defecto en staging; cambiar temporalmente a Warning, Information o Debug.
Serilog__MinimumLevel__Default=Error
Serilog__MinimumLevel__Override__Microsoft=Error
Serilog__MinimumLevel__Override__System=Error
